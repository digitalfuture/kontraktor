<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
  <%- include('partials/_head') %>
<body class="bg-gray-200 dark:bg-gray-950 text-gray-900 dark:text-gray-100">
  <!-- Anti-flash -->
  <%- include('partials/_anti-flash') %>

  <%- include('partials/header') %>
  
  <main id="main-content">
    <!-- Header -->
    <section class="bg-gradient-to-br from-orange-50 dark:from-gray-900 to-gray-200 dark:to-gray-950 py-8 sm:py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-3"><%= t('services.title') %></h1>
        <p class="text-gray-600 dark:text-gray-300 text-lg max-w-2xl"><%= t('services.subtitle') %></p>
        
        <!-- Search -->
        <div class="mt-6 max-w-xl">
          <form action="/services" method="GET" class="flex gap-2" onsubmit="return false;">
            <input type="text" id="service-search" placeholder="<%= t('services.findService') %>" class="flex-1 h-11 px-4 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-700 focus:border-transparent">
            <%- include('partials/_search-btn', { type: 'button', size: 'md', onclick: "document.getElementById('service-search').focus()" }) %>
          </form>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="py-8 sm:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="services-grid">
          <% services.forEach(function(service) { %>
          <a href="/services/<%= service.slug %>" class="service-card block bg-gradient-to-b from-white to-orange-50/30 dark:from-gray-900 dark:to-orange-950/30 border border-gray-200 dark:border-gray-700 rounded-xl hover:shadow-lg hover:border-orange-300 dark:hover:border-orange-600 transition group overflow-hidden">
            <% var imgFile = slugToImage[service.slug]; if (imgFile) { %>
            <div class="p-3 pb-0">
              <div class="w-full aspect-[3/2] bg-transparent overflow-hidden rounded-lg">
                <img src="/images/<%= imgFile %>" alt="<%= t('categories.' + service.slug) %>" class="w-full h-full object-cover" loading="lazy">
              </div>
            </div>
            <% } %>
            <div class="p-6">
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-orange-600 transition"><%= t('categories.' + service.slug) %></h2>
              <p class="text-sm text-gray-600 dark:text-gray-300 mb-4"><%= service.description %></p>
            <div class="flex flex-col gap-1 pt-3 border-t border-gray-200 dark:border-gray-700">
              <% service.subcategories.slice(0, 3).forEach(function(sub) { %>
              <span class="text-sm text-gray-700 dark:text-gray-300"><%= t('subcategories.' + sub.slug) %></span>
              <% }); %>
              <% if (service.subcategories.length > 3) { %>
              <p class="text-sm text-orange-700 mt-1">+ <%= service.subcategories.length - 3 %> <%= t('services.more') %></p>
              <% } %>
            </div>
          </div>
        </a>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 sm:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3"><%= t('services.needSomethingElse') %></h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6"><%= t('services.ctaPostProject') %></p>
        <%- include('partials/_post-project-btn', {extraClass: 'px-8 py-3 text-lg shadow-lg shadow-orange-600/30'}) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    // Client-side search
    document.getElementById('service-search')?.addEventListener('input', function() {
      const q = this.value.toLowerCase();
      document.querySelectorAll('.service-card').forEach(function(card) {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(q) ? '' : 'none';
      });
    });
  </script>
</body>
</html>
