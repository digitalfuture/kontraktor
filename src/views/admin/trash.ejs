<%- include('_admin-layout', { activePage: 'trash' }) %>

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white inline-flex items-center gap-2 leading-none">
              <span class="mat-icon text-2xl text-gray-500 dark:text-gray-300 text-sm text-sm text-gray-700 dark:text-gray-200 text-lg text-gray-800 dark:text-gray-200 text-gray-500 text-sm text-gray-400 text-sm text-gray-400 dark:text-gray-500 text-gray-900 dark:text-white text-xs text-red-700 dark:text-red-300 text-sm text-gray-500 dark:text-gray-300 text-sm text-white text-sm text-red-600 text-lg text-gray-800 dark:text-gray-200 text-gray-500 text-sm text-gray-400 text-sm text-gray-400 dark:text-gray-500 text-gray-900 dark:text-white text-xs text-red-700 dark:text-red-300 text-sm text-gray-500 dark:text-gray-300 text-xs text-purple-700 dark:text-purple-300 text-orange-700 dark:text-orange-300 text-blue-700 dark:text-blue-300 text-sm text-white text-sm text-red-600 text-lg text-gray-800 dark:text-gray-200 text-gray-500 text-sm text-gray-400 text-sm text-gray-400 dark:text-gray-500 text-gray-900 dark:text-white text-yellow-500 text-xs text-red-700 dark:text-red-300 text-sm text-gray-500 dark:text-gray-300 text-xs text-gray-400 text-sm text-white text-sm text-red-600 text-lg text-gray-800 dark:text-gray-200 text-gray-500 text-sm text-gray-400 text-sm text-gray-400 dark:text-gray-500 text-gray-900 dark:text-white text-xs text-red-700 dark:text-red-300 text-sm text-gray-500 dark:text-gray-300 text-sm text-white text-sm text-red-600 text-lg text-gray-800 dark:text-gray-200 text-gray-500 text-sm text-gray-400 text-sm text-gray-400 dark:text-gray-500 text-gray-900 dark:text-white text-xs text-red-700 dark:text-red-300 text-sm text-gray-500 dark:text-gray-300 text-xs text-green-700 dark:text-green-300 text-blue-700 dark:text-blue-300 text-gray-600 dark:text-gray-300 text-sm text-white text-sm text-red-600 text-lg text-gray-800 dark:text-gray-200 text-gray-500">groups</span>
            <%= t('email.mailingLists') || 'Mailing Lists' %> <span class="text-sm font-normal text-gray-400">(<%= mailingLists.length %>)</span>
          </h2>

          <% if (mailingLists.length === 0) { %>
            <p class="text-sm text-gray-400 dark:text-gray-500 pl-7"><%= t('admin.noDeletedMailingLists') || 'No deleted mailing lists' %></p>
          <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
              <% mailingLists.forEach(function(ml) { %>
              <div id="ml-<%= ml.id %>" class="flex flex-col bg-white dark:bg-gray-800 rounded-card shadow-card border border-gray-200 dark:border-gray-700 p-4 sm:p-6 opacity-75">
                <div class="flex-grow">
                  <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-gray-900 dark:text-white line-through decoration-red-500"><%= ml.name || '—' %></h3>
                    <span class="text-xs px-2 py-1 rounded-full font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300"><%= t('admin.deleted') || 'Deleted' %></span>
                  </div>
                  <% if (ml.description) { %><p class="text-sm text-gray-500 dark:text-gray-300 mb-1 line-clamp-2"><%= ml.description %></p><% } %>
                </div>
                <div class="flex items-center justify-between pt-3 border-t border-gray-200 dark:border-gray-700 mt-auto">
                  <form action="/api/admin/email/lists/<%= ml.id %>/restore" method="POST" hx-post="/api/admin/email/lists/<%= ml.id %>/restore" hx-target="#ml-<%= ml.id %>" hx-swap="outerHTML swap:300ms">
                    <%- include('../partials/csrf-field') %>
                    <button type="submit" data-requires-edit class="w-auto text-sm font-medium px-4 py-2 rounded-lg bg-green-600 text-white hover:bg-green-700 dark:bg-green-600 dark:hover:bg-green-500 transition cursor-pointer"><%= t('admin.restore') || 'Restore' %></button>
                  </form>
                </div>
              </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <!-- Mailing List Contacts Section -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4 flex items-center gap-2">
            <span class="mat-icon text-xl text-gray-500 text-sm text-gray-400 text-sm text-gray-400 dark:text-gray-500 text-gray-900 dark:text-white text-xs text-red-700 dark:text-red-300 text-sm text-gray-500 dark:text-gray-300 text-xs text-sm text-white text-center text-gray-400">delete</span>
            <h3 class="text-lg font-medium text-gray-900 dark:text-white"><%= t('admin.trashEmpty') || 'Trash is empty' %></h3>
          </div>
        <% } %>

<%- include('_admin-layout-close') %>
</body>
</html>
