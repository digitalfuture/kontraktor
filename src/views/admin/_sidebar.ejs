<aside data-admin-sidebar class="fixed inset-y-0 left-0 z-40 w-64 bg-gray-900 dark:bg-gray-950 text-white flex flex-col border-r border-gray-800 dark:border-gray-800 transform -translate-x-full min-[1600px]:translate-x-0 min-[1600px]:sticky min-[1600px]:top-0 min-[1600px]:h-svh transition-transform duration-300 ease-in-out overflow-y-auto scrollbar-none">
  <%- include('../partials/_sidebar-header', { sidebarBreakpoint: 'min-[1600px]', subtitle: typeof t !== 'undefined' ? t('nav.admin') : 'Admin Panel' }) %>
  
  <style>
    .scrollbar-none {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
  </style>
  
  <nav class="flex-1 p-4 space-y-1">
    <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">home</span>
      <%= typeof t !== 'undefined' ? t('account.overview') : 'Overview' %>
    </a>
    <a href="/admin/projects" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">description</span>
      <%= typeof t !== 'undefined' ? t('admin.projects') : 'Projects' %>
    </a>
    <a href="/admin/contractors" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'contractors' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">groups</span>
      <%= typeof t !== 'undefined' ? t('admin.contractors') : 'Contractors' %>
    </a>
    <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'users' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">people</span>
      <%= typeof t !== 'undefined' ? t('admin.users') : 'Users' %>
    </a>
    <a href="/admin/categories" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'categories' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">label</span>
      <%= typeof t !== 'undefined' ? t('admin.categories') : 'Categories' %>
    </a>
    <a href="/admin/reviews" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'reviews' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">star</span>
      <%= typeof t !== 'undefined' ? t('admin.reviews') : 'Reviews' %>
    </a>
    <a href="/admin/payments" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'payments' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">mail</span>
      <%= typeof t !== 'undefined' ? t('admin.payments') : 'Payments' %>
    </a>
    <a href="/admin/diagrams" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'diagrams' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">dashboard</span>
      <%= typeof t !== 'undefined' ? t('admin.diagrams') : 'Diagrams' %>
    </a>
    <a href="/admin/email" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'email' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">mail</span>
      <%= t('email.title') %>
    </a>
    <a href="/admin/email/settings" class="flex items-center gap-3 pl-11 pr-4 py-1.5 text-sm rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'email-settings' ? 'text-orange-400' : 'text-gray-400 hover:text-gray-200' %>">
      <span class="mat-icon text-base">settings</span>
      <%= typeof t !== 'undefined' ? t('email.settings') : 'Settings' %>
    </a>
    <a href="/admin/email/templates" class="flex items-center gap-3 pl-11 pr-4 py-1.5 text-sm rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'email' ? 'text-orange-400' : 'text-gray-400 hover:text-gray-200' %>">
      <span class="mat-icon text-base">code</span>
      <%= typeof t !== 'undefined' ? t('email.systemTemplates') : 'Templates' %>
    </a>
    <a href="/admin/analytics" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'analytics' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">bar_chart</span>
      <%= typeof t !== 'undefined' ? t('analytics.title') : 'Analytics' %>
    </a>
    <a href="/admin/database" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'database' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">storage</span>
      <%= typeof t !== 'undefined' ? t('admin.database') : 'Database' %>
    </a>
    <a href="/admin/backup" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'backup' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">sync</span>
      <%= typeof t !== 'undefined' ? t('admin.backup') : 'Backup' %>
    </a>
    <a href="/admin/trash" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= typeof activePage !== 'undefined' && activePage === 'trash' ? 'bg-orange-700 text-white' : 'text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800' %>">
      <span class="mat-icon text-xl">delete</span>
      <%= typeof t !== 'undefined' ? (t('admin.trash') || 'Trash') : 'Trash' %>
    </a>
  </nav>
  
  <div class="p-4 border-t border-gray-800">
    <!-- Back to site -->
    <a href="/" class="flex items-center gap-3 px-4 py-2 rounded-lg text-gray-300 hover:bg-gray-800 dark:hover:bg-gray-800 transition text-sm">
      <span class="mat-icon text-xl text-gray-400">arrow_back</span>
      <%= typeof t !== 'undefined' ? t('nav.home') : 'Back to site' %>
    </a>
    <a href="/auth/logout" class="flex items-center gap-3 px-4 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-red-400 transition text-sm">
      <span class="mat-icon text-xl text-gray-400">logout</span>
      <%= typeof t !== 'undefined' ? t('nav.logout') : 'Logout' %>
    </a>
  </div>
</aside>
