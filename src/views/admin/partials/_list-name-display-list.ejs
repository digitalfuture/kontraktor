<span id="list-name-<%= list.id %>">
  <a href="/admin/email/lists/<%= list.id %>" class="text-orange-600 hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300"><%= list.name %></a>
</span>
<button type="button" class="text-gray-400 hover:text-orange-600 dark:text-gray-500 dark:hover:text-orange-400 p-1 rounded transition" hx-get="/api/admin/email/lists/<%= list.id %>/edit-name" hx-target="#list-name-<%= list.id %>" hx-swap="outerHTML" title="<%= typeof t !== 'undefined' ? t('email.edit') : 'Edit' %>">    <span class="mat-icon text-base">edit</span></button>