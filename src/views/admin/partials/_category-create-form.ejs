<form id="addCategoryForm" action="/api/admin/categories/create" method="POST"
      hx-post="/api/admin/categories/create" hx-target="#addCategoryForm" hx-swap="outerHTML">
  <%- include('../../partials/csrf-field') %>
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-4 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-sm text-red-700 dark:text-red-300"><%= error %></div>
  <% } %>
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("admin.slug") %> *</label>
      <input type="text" name="slug" required placeholder="e.g. plumbing" value="<%= typeof slug !== 'undefined' ? slug : '' %>" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("admin.nameEn") %> *</label>
      <input type="text" name="name_en" required placeholder="<%= t('admin.nameEn') %>" value="<%= typeof name_en !== 'undefined' ? name_en : '' %>" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("admin.nameId") %></label>
      <input type="text" name="name_id" placeholder="<%= t('admin.nameId') %>" value="<%= typeof name_id !== 'undefined' ? name_id : '' %>" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("admin.descriptionEn") %></label>
      <textarea name="description_en" rows="2" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"><%= typeof description_en !== 'undefined' ? description_en : '' %></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("admin.descriptionId") %></label>
      <textarea name="description_id" rows="2" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"><%= typeof description_id !== 'undefined' ? description_id : '' %></textarea>
    </div>
  </div>
  <div class="flex gap-3 mt-6">
    <button type="submit" class="bg-orange-700 text-white px-4 py-2 rounded hover:bg-orange-800 transition cursor-pointer"><%= t("admin.create") %></button>
    <button type="button" onclick="document.getElementById('addCategoryModal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer"><%= t("admin.cancel") %></button>
  </div>
</form>
