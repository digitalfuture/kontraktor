<section id="services" class="py-16 sm:py-20 lg:py-28 bg-gradient-to-b from-white via-orange-50/40 to-white dark:from-gray-900 dark:via-gray-950 dark:to-gray-900" aria-labelledby="services-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 max-w-2xl mx-auto">
      <h2 id="services-title" class="text-3xl sm:text-4xl font-black text-gray-900 dark:text-white tracking-tight">
        <%= t('services.title') %>
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300"><%= t('services.subtitle') %></p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% const serviceSlugs = ['apartment-renovation', 'electrical-work', 'plumbing', 'finishing', 'construction', 'roofing', 'facade', 'landscaping', 'demolition']; %>
      <% const slugToImage = {
        'demolition': 'Demolition.PNG',
        'electrical-work': 'Electrical.PNG',
        'facade': 'Facade.PNG',
        'finishing': 'Finishing.PNG',
        'construction': 'Home Building.PNG',
        'landscaping': 'Landscaping.PNG',
        'plumbing': 'Plumbing.PNG',
        'apartment-renovation': 'Renovation.PNG',
        'roofing': 'Roofing.PNG',
      }; %>
      <% serviceSlugs.forEach(function(slug) { %>
        <% const svc = services.find(s => s.slug === slug); %>
        <% if (svc) { %>
          <a href="/services/<%= slug %>" class="card-modern-glass group block flex flex-col overflow-hidden">
            <div class="relative w-full h-48 bg-orange-50/30 dark:bg-gray-800/30 overflow-hidden">
              <img src="/images/<%= slugToImage[slug] %>" alt="<%= t('services.cats.' + slug + '.name') %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors"><%= t('services.cats.' + slug + '.name') %></h3>
              <p class="mt-2.5 text-gray-600 dark:text-gray-300 text-sm leading-relaxed flex-1"><%= t('services.cats.' + slug + '.desc') %></p>
              <div class="mt-5 pt-4 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between">
                <% if (svc.totalContractors > 0) { %>
                  <span class="badge-modern">
                    <span class="mat-icon text-sm text-orange-500">group</span>
                    <span><%= svc.totalContractors %> <%= t('services.contractors') %></span>
                  </span>
                <% } else { %>
                  <span class="text-xs text-gray-400 font-medium">0 <%= t('services.contractors') %></span>
                <% } %>
                <span class="text-orange-600 dark:text-orange-400 group-hover:translate-x-1 transition-transform inline-flex items-center text-sm font-semibold">
                  <span>Услуги</span>
                  <span class="mat-icon text-lg">chevron_right</span>
                </span>
              </div>
            </div>
          </a>
        <% } else { %>
          <div class="card-modern-glass opacity-60 flex flex-col overflow-hidden">
            <div class="w-full h-48 bg-orange-50/20 dark:bg-gray-800/20 overflow-hidden">
              <img src="/images/<%= slugToImage[slug] %>" alt="<%= t('services.cats.' + slug + '.name') %>" class="w-full h-full object-cover" loading="lazy">
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white"><%= t('services.cats.' + slug + '.name') %></h3>
              <p class="mt-2.5 text-gray-600 dark:text-gray-300 text-sm flex-1"><%= t('services.cats.' + slug + '.desc') %></p>
              <div class="mt-5 pt-4 border-t border-gray-100 dark:border-gray-800 flex items-center justify-end">
                <span class="text-xs text-gray-400">0 <%= t('services.contractors') %></span>
              </div>
            </div>
          </div>
        <% } %>
      <% }); %>
    </div>
  </div>
</section>
