<%#
/**
 * Sitemap Tree Diagram — reusable D3.js partial (stack/drill-down only)
 * 
 * Usage:
 *   <%- include('_sitemap') %>
 *
 * Shows 2 levels at a time, click to drill down, breadcrumb to go back.
 *
 * Data shape (JSON):
 *   { name: "Root", category: "root", children: [
 *     { name: "Section", category: "public", middleware: "", children: [
 *       { name: "/path", value: 1, category: "public", leaf: true }
 *     ], value: N },
 *   ]}
 *
 * Defaults to data embedded in <script id="sitemap-data"> on the page,
 * or to an inline fallback if none found.
 */
-%>
<div id="sitemap-root" class="w-full relative">
  <div id="sitemap-breadcrumb" class="flex items-center gap-0.5 text-sm text-gray-500 dark:text-gray-400 flex-wrap min-h-[24px] mb-3"></div>
  <div id="sitemap-viz" class="w-full min-h-[250px] flex items-center justify-center overflow-hidden">
    <svg style="display:block;width:100%;height:auto;max-width:1200px" viewBox="0 0 1000 400"></svg>
    <div class="hint fixed bottom-4 left-1/2 -translate-x-1/2 z-10 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400 text-xs px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm pointer-events-none">
      <%= typeof t !== 'undefined' ? t('admin.sitemapHint') : '📁 click to drill down • click background to go back' %>
    </div>
  </div>
</div>

<script>
(function() {
  // ── Data source ──────────────────────────────────────────────────────────
  var data = null;
  var dataEl = document.getElementById('sitemap-data');
  if (dataEl) {
    try { data = JSON.parse(dataEl.textContent); } catch(e) {}
  }
  if (!data) {
    // Inline fallback from EJS (data arg or empty tree)
    data = <%= JSON.stringify(data || { name: '🏠 Kontraktor', category: 'root', children: [] }) %>;
    // If no inline data either, fetch auto-generated JSON
    if (data.children.length === 0) {
      var xhr = new XMLHttpRequest();
      xhr.open('GET', '/static/docs/sitemap-map.json', false);
      try { xhr.send(); data = JSON.parse(xhr.responseText); } catch(e) {}
    }
  }

  var rootEl = document.getElementById('sitemap-root');
  var vizEl = document.getElementById('sitemap-viz');
  var bcEl = document.getElementById('sitemap-breadcrumb');
  var svg = d3.select(vizEl.querySelector('svg'));
  var g = svg.append('g');

  var color = d3.scaleOrdinal()
    .domain(['root','admin','auth','account','payments','public'])
    .range(['#ea580c','#2563eb','#7c3aed','#059669','#d97706','#6b7280']);

  var nodeSepY = 22, nodeSepX = 140;
  var zoomStack = [];
  var isLoading = false;

  function isEmpty(d) { return !d.children || d.children.length === 0; }

  // ── Breadcrumb ─────────────────────────────────────────────────────────────
  function breadcrumb() {
    bcEl.innerHTML = '';
    zoomStack.forEach(function(d, i) {
      if (i > 0) bcEl.appendChild(el('span', { 'class': 'sep', 'text': ' › ' }));
      var label = d.data.name.length > 28 ? d.data.name.slice(0,25) + '…' : d.data.name;
      var span = el('span', { 'class': i === zoomStack.length - 1 ? 'crumb here' : 'crumb', 'text': label });
      if (i < zoomStack.length - 1) span.onclick = function() { zoomToCrumb(i); };
      bcEl.appendChild(span);
    });
  }

  function zoomToCrumb(idx) {
    if (isLoading) return;
    zoomStack.splice(idx + 1);
    drawStack(zoomStack[idx]);
  }

  // ── STACK MODE: 2-level drill-down ─────────────────────────────────────────
  function drawStack(node) {
    isLoading = true;
    g.selectAll('*').remove();

    var root = d3.hierarchy(node.data);
    if (!root.children) { isLoading = false; return; }

    var treeLayout = d3.tree().nodeSize([nodeSepY, nodeSepX]).separation(function() { return 1; });
    treeLayout(root);

    var visibleNodes = root.descendants().filter(function(d) { return d.depth <= 1; });
    var visibleLinks = root.links().filter(function(l) { return l.target.depth <= 1; });

    var x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
    visibleNodes.forEach(function(d) {
      var leftW = d.depth === 0 ? d.data.name.length * 10 + 20 : 0;
      var rightW = d.depth > 0 ? d.data.name.length * 8 + 30 : 0;
      if (d.y - leftW - 16 < x0) x0 = d.y - leftW - 16;
      if (d.y + rightW + 16 > x1) x1 = d.y + rightW + 16;
      if (d.x < y0) y0 = d.x;
      if (d.x > y1) y1 = d.x;
    });

    var padY = 30;
    var vw = Math.max(x1 - x0, 500);
    var vh = Math.max(y1 - y0 + padY * 2, 250);
    // Center the viewBox on the tree's midpoint so content is never top-left biased
    svg.attr('viewBox', [(x0 + x1) / 2 - vw / 2, (y0 + y1) / 2 - vh / 2, vw, vh]);

    renderLinks(g, visibleNodes, visibleLinks);
    renderNodes(g, visibleNodes);

    // Click handlers
    g.selectAll('g.node-group').filter(function(d) { return !isEmpty(d.data); })
      .style('cursor', 'pointer')
      .on('click', function(event, d) {
        if (isLoading) return;
        event.stopPropagation();
        zoomStack.push(d);
        drawStack(d);
      });

    breadcrumb();
    isLoading = false;
  }

  // ── Shared render helpers ──────────────────────────────────────────────────
  function renderLinks(svgGroup, nodes, links) {
    var linkGen = d3.linkHorizontal().x(function(d) { return d[0]; }).y(function(d) { return d[1]; });
    svgGroup.selectAll('path')
      .data(links)
      .join('path')
      .attr('fill', 'none')
      .attr('stroke', '#d1d5db')
      .attr('stroke-opacity', 0.5)
      .attr('stroke-width', 1.5)
      .attr('d', function(d) {
        return linkGen({ source: [d.source.y, d.source.x], target: [d.target.y, d.target.x] });
      });
  }

  function renderNodes(svgGroup, nodes) {
    var nodeG = svgGroup.selectAll('g')
      .data(nodes)
      .join('g')
      .attr('class', function(d) { return 'node-group' + (isEmpty(d.data) ? ' nodrill' : ''); });

    // Circle
    nodeG.append('circle')
      .attr('cx', function(d) { return d.y; })
      .attr('cy', function(d) { return d.x; })
      .attr('r', function(d) { return d.data.leaf ? 4 : 6; })
      .attr('fill', function(d) { return color(d.data.category || 'public'); })
      .attr('stroke', function(d) { return d3.color(color(d.data.category || 'public')).darker(0.4); })
      .attr('stroke-width', 1.5);

    // Label
    nodeG.append('text')
      .attr('class', 'node-label')
      .attr('text-anchor', function(d) { return d.depth === 0 ? 'end' : 'start'; })
      .attr('x', function(d) { return d.depth === 0 ? d.y - 14 : d.y + 14; })
      .attr('y', function(d) { return d.x + 5; })
      .attr('font-size', function(d) {
        if (d.depth === 0) return '14px';
        return d.data.leaf ? '12px' : '14px';
      })
      .attr('font-weight', function(d) { return d.depth === 0 ? '700' : '500'; })
      .attr('fill', function(d) {
        if (d.depth === 0) return '#ea580c';
        var isDark = rootEl.classList.contains('dark') || rootEl.closest('.dark');
        return isDark ? '#e2e8f0' : '#1f2937';
      })
      .text(function(d) {
        if (d.depth === 0) return d.data.name;
        var icon = d.data.leaf ? '📄' : '📁';
        return icon + ' ' + d.data.name;
      });

    // Child count badge (only for non-leaf, depth > 0)
    nodeG.filter(function(d) { return !isEmpty(d.data) && d.depth > 0; }).append('text')
      .attr('class', 'node-count')
      .attr('text-anchor', 'start')
      .attr('x', function(d) { return d.y + 14; })
      .attr('y', function(d) { return d.x + 19; })
      .attr('font-size', '10px')
      .attr('fill', '#9ca3af')
      .text(function(d) {
        var count = d.data.children ? d.data.children.length : 0;
        return count > 0 ? count + ' page' + (count > 1 ? 's' : '') : '';
      });
  }

  // ── Helper: create element ─────────────────────────────────────────────────
  function el(tag, attrs) {
    var e = document.createElement(tag);
    for (var k in attrs) {
      if (k === 'text') e.textContent = attrs[k];
      else e.setAttribute(k, attrs[k]);
    }
    return e;
  }

  // ── Init ───────────────────────────────────────────────────────────────────
  zoomStack = [d3.hierarchy(data)];
  drawStack(zoomStack[0]);

  // Click background to zoom out
  svg.on('click', function(event) {
    if (event.target.tagName === 'svg' && zoomStack.length > 1) {
      zoomStack.pop();
      drawStack(zoomStack[zoomStack.length - 1]);
    }
  });

  // Re-draw on theme change (dark mode toggle)
  var obs = new MutationObserver(function() {
    drawStack(zoomStack[zoomStack.length - 1]);
  });
  obs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
})();
</script>
