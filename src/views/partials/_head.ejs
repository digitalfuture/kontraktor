<head>
  <% if (typeof GA_TRACKING_ID !== 'undefined' && GA_TRACKING_ID && !GA_DISABLED) { %>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= GA_TRACKING_ID %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= GA_TRACKING_ID %>');
    </script>
  <% } %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof seo !== 'undefined' && seo.title ? seo.title : (typeof title !== 'undefined' ? title : (typeof t === 'function' ? (t('site.name') + ' — ' + t('site.tagline')) : 'Kontraktor')) %></title>
  <meta name="description" content="<%= typeof seo !== 'undefined' && seo.description ? seo.description : (typeof description !== 'undefined' ? description : (typeof t === 'function' ? t('site.description') : '')) %>">
  <% if (typeof seo !== 'undefined' && seo.keywords) { %>
  <meta name="keywords" content="<%= seo.keywords %>">
  <% } %>
  <meta name="theme-color" content="#ea580c">
  <meta name="geo.region" content="ID">
  <meta name="geo.placename" content="Indonesia">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <!-- Canonical -->
  <% if (typeof seo !== 'undefined' && seo.canonical) { %>
  <link rel="canonical" href="<%= seo.canonical %>" />
  <% } else { %>
  <link rel="canonical" href="https://kontraktor.app<%= (typeof pagePath !== 'undefined' ? pagePath : '/') %>" />
  <% } %>
  <!-- Hreflang -->
  <% if (typeof seo !== 'undefined' && typeof renderAlternateLinks !== 'undefined') { %>
  <%- renderAlternateLinks(Object.assign({}, seo, {
      alternateLocales: (typeof alternateLocales !== 'undefined' && alternateLocales.length ? alternateLocales : (seo && seo.alternateLocales) || []),
      canonical: (seo && seo.canonical) || (typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://kontraktor.app/')
    })) %>
  <% } %>
  <!-- Open Graph -->
  <meta property="og:type" content="<%= typeof seo !== 'undefined' && seo.ogType ? seo.ogType : 'website' %>">
  <meta property="og:site_name" content="<%= typeof t === 'function' ? t('site.name') : 'Kontraktor' %>">
  <meta property="og:locale" content="<%= typeof locale !== 'undefined' && locale === 'id' ? 'id_ID' : 'en_US' %>">
  <meta property="og:locale:alternate" content="<%= typeof locale !== 'undefined' && locale === 'id' ? 'en_US' : 'id_ID' %>">
  <meta property="og:title" content="<%= typeof seo !== 'undefined' && seo.title ? seo.title : (typeof title !== 'undefined' ? title : (typeof t === 'function' ? (t('site.name') + ' — ' + t('site.tagline')) : 'Kontraktor')) %>">
  <meta property="og:description" content="<%= typeof seo !== 'undefined' && seo.description ? seo.description : (typeof description !== 'undefined' ? description : (typeof t === 'function' ? t('site.description') : '')) %>">
  <meta property="og:url" content="<%= typeof seo !== 'undefined' && seo.canonical ? seo.canonical : (typeof ogUrl !== 'undefined' ? ogUrl : 'https://kontraktor.app') %>">
  <meta property="og:image" content="<%= typeof seo !== 'undefined' && seo.ogImage ? seo.ogImage : (typeof ogImage !== 'undefined' ? ogImage : 'https://kontraktor.app/og-image.png') %>">
  <% if (typeof seo !== 'undefined' && seo.publishedTime) { %>
  <meta property="article:published_time" content="<%= seo.publishedTime %>">
  <% } %>
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof seo !== 'undefined' && seo.title ? seo.title : (typeof title !== 'undefined' ? title : (typeof t === 'function' ? (t('site.name') + ' — ' + t('site.tagline')) : 'Kontraktor')) %>">
  <meta name="twitter:description" content="<%= typeof seo !== 'undefined' && seo.description ? seo.description : (typeof description !== 'undefined' ? description : (typeof t === 'function' ? t('site.description') : '')) %>">
  <meta name="twitter:image" content="<%= typeof seo !== 'undefined' && seo.ogImage ? seo.ogImage : (typeof ogImage !== 'undefined' ? ogImage : 'https://kontraktor.app/og-image.png') %>">
  <!-- JSON-LD Structured Data -->
  <% if (typeof seo !== 'undefined' && typeof renderJsonLd !== 'undefined') { %>
  <%- renderJsonLd(seo) %>
  <% } %>
  <% if (typeof seo !== 'undefined' && seo.noIndex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <% if (typeof nonProd !== 'undefined' && nonProd) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <!-- HTMX -->
  <script src="/js/htmx.min.js" defer></script>
  <!-- Main JS -->
  <script src="/js/main.js?v=<%= typeof cssVersion !== 'undefined' ? cssVersion : '1' %>" defer></script>
  <!-- Tailwind -->
  <link rel="stylesheet" href="/css/tailwind.css?v=<%= typeof cssVersion !== 'undefined' ? cssVersion : '1' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet"></noscript>
  <!-- Material Symbols (icons) - loaded async to avoid render-blocking -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0,0&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0,0&display=swap"></noscript>
  <style>
    .mat-icon { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-block; white-space: nowrap; word-wrap: normal; direction: ltr; -webkit-font-smoothing: antialiased; vertical-align: middle; }
    .mat-icon.hidden { display: none !important; }
  </style>
</head>
