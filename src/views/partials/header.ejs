<!-- <%= t("header.skipToMain") %> (accessibility) -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-orange-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-700">
  <%= t("header.skipToMain") %>
</a>

<header class="bg-white dark:bg-gray-900 sticky top-0 z-50" role="banner">
  <!-- Thin gradient accent bar -->
  <div class="h-0.5 bg-gradient-to-r from-orange-500 via-orange-400 to-amber-500"></div>
  <div class="border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo + Mobile Hamburger (left) -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-orange-700 dark:text-orange-400 hover:text-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-700 text-sm font-semibold" aria-label="<%= t("header.openMenu") %>" aria-expanded="false">
          <span id="hamburger-icon" class="mat-icon text-2xl">menu</span>
          <span id="close-icon" class="mat-icon text-2xl hidden">close</span>
        </button>
        <a href="/" class="text-2xl font-bold text-orange-700 hover:text-orange-700 transition" aria-label="<%= t("header.logoLabel") %>">
          Kontraktor
        </a>
      </div>
      
      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-6" aria-label="Main navigation">
        <a href="/services" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition whitespace-nowrap"><%= t('nav.services') %></a>
        <a href="/projects" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition whitespace-nowrap"><%= t('nav.browseProjects') %></a>
        <a href="/contractors" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition whitespace-nowrap"><%= t('nav.contractors') %></a>
      </nav>
      
      <!-- Desktop Controls (Lang + Theme) -->
      <div class="hidden md:flex items-center space-x-3">
        <%- include('_controls', {
          locale: typeof locale !== 'undefined' ? locale : 'en',
          locales: typeof locales !== 'undefined' ? locales : ['id', 'en'],
          controlsIdPrefix: 'public',
          isAdmin: false,
          extraLangParams: ''
        }) %>
      </div>
      
      <!-- Auth / Account (desktop) -->
      <div class="hidden md:flex items-center space-x-4" role="navigation" aria-label="Account">
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.is_contractor) { %>
            <a href="/contractors/dashboard" class="text-orange-700 dark:text-orange-400 hover:text-orange-700 transition font-medium inline-flex items-center gap-1.5" aria-label="<%= t('contractorDashboard.myBids') %>"><span class="mat-icon text-base">receipt_long</span> <%= t('contractorDashboard.myBids') %></a>
          <% } else if (user.role === 'client') { %>
            <a href="/contractors/register" class="text-orange-700 dark:text-orange-400 hover:text-orange-700 transition font-medium text-sm whitespace-nowrap"><%= t('account.registerContractor') %></a>
          <% } %>
          <a href="/account" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition font-medium inline-flex items-center gap-1.5"><span class="mat-icon text-base">person</span> <%= t('nav.account') %></a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="text-gray-500 dark:text-gray-300 hover:text-orange-600 transition text-sm inline-flex items-center gap-1.5"><span class="mat-icon text-base">settings</span> <%= t('nav.admin') %></a>
          <% } %>
          <a href="/auth/logout" class="inline-flex items-center gap-1.5 text-gray-500 dark:text-gray-300 hover:text-red-600 transition text-sm"><span class="mat-icon text-base">logout</span><%= t('nav.logout') %></a>
        <% } else { %>
          <a href="/auth/login" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition font-medium"><%= t('nav.login') %></a>
        <% } %>
        <%- include('./_post-project-btn') %>
      </div>
    </div>
  </div>
  </div> <!-- /border-b -->
</header>

<!-- Mobile Sidebar (slides from left, md:hidden) -->
<aside id="mobile-sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 flex flex-col border-r border-gray-200 dark:border-gray-700 transform -translate-x-full md:hidden transition-transform duration-300 ease-in-out shadow-xl">
  <!-- Sidebar Header -->
  <div class="px-4 py-2 min-h-[3.25rem] border-b border-gray-200 dark:border-gray-700 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-3">
      <button onclick="var s=document.getElementById('mobile-sidebar');s.classList.add('-translate-x-full');s.classList.remove('translate-x-0');var b=document.getElementById('mobile-menu-btn');if(b)b.setAttribute('aria-expanded','false');var h=document.getElementById('hamburger-icon'),c=document.getElementById('close-icon');if(h&&c){h.classList.remove('hidden');c.classList.add('hidden');}" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 active:bg-gray-200 dark:active:bg-gray-700 text-gray-500 dark:text-gray-300 cursor-pointer transition-colors focus:outline-none" aria-label="Close sidebar">
        <span class="mat-icon text-xl text-gray-500 dark:text-gray-300">close</span>
      </button>
      <a href="/" class="text-lg font-bold text-orange-700 leading-none">Kontraktor</a>
    </div>
  </div>

  <!-- Sidebar Nav -->
  <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
    <a href="/services" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <%= t('nav.services') %>
    </a>
    <a href="/projects" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <%= t('nav.browseProjects') %>
    </a>
    <a href="/contractors" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <%= t('nav.contractors') %>
    </a>

    <!-- Language switcher (mobile) -->
    <div class="pt-4 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= typeof t !== 'undefined' ? t('nav.language') || 'Language' : 'Language' %></p>
    </div>
    <div class="flex items-center gap-1 px-4 py-3" role="group" aria-label="Language switcher">
      <% typeof locales !== 'undefined' && locales.forEach(function(loc) { %>
        <a href="?lang=<%= loc %>" class="px-3 py-1.5 rounded-lg text-sm font-medium transition cursor-pointer <%= locale === loc ? 'bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-200' : 'text-gray-500 dark:text-gray-300 hover:text-gray-700 dark:hover:text-gray-200' %>">
          <%= loc.toUpperCase() %>
        </a>
      <% }); %>
    </div>

    <!-- Theme Toggle (mobile) — segmented, both icons visible, active highlighted -->
    <div class="pt-2 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= typeof t !== 'undefined' ? t('nav.colorTheme') || 'Color theme' : 'Color theme' %></p>
    </div>
    <div class="flex items-center gap-1 px-4 py-3" role="group" aria-label="Theme switcher">
      <button type="button" id="mobile-theme-light" class="flex items-center justify-center px-2.5 py-1.5 rounded-lg transition cursor-pointer text-gray-500 dark:text-gray-300 hover:text-gray-700 dark:hover:text-gray-200" aria-label="Light theme">
        <span class="mat-icon text-lg">light_mode</span>
      </button>
      <button type="button" id="mobile-theme-dark" class="flex items-center justify-center px-2.5 py-1.5 rounded-lg transition cursor-pointer text-gray-500 dark:text-gray-300 hover:text-gray-700 dark:hover:text-gray-200" aria-label="Dark theme">
        <span class="mat-icon text-lg">dark_mode</span>
      </button>
    </div>

    <!-- Auth section -->
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.is_contractor) { %>
      <a href="/contractors/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-orange-700 dark:text-orange-400 hover:bg-gray-100 dark:hover:bg-gray-800">
        <span class="mat-icon text-xl">receipt_long</span>
        <%= t('contractorDashboard.myBids') %>
      </a>
      <% } else if (user.role === 'client') { %>
      <a href="/contractors/register" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-orange-700 dark:text-orange-400 hover:bg-gray-100 dark:hover:bg-gray-800">
        <span class="mat-icon text-xl">person_add</span>
        <%= t('account.registerContractor') %>
      </a>
      <% } %>
    <div class="pt-4 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= t('nav.account') %></p>
    </div>
    <a href="/account" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <span class="mat-icon text-xl text-gray-500 dark:text-gray-400">person</span>
      <%= t('nav.account') %>
    </a>
    <% if (user.role === 'admin') { %>
    <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-500 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800"><span class="mat-icon text-xl">settings</span> <%= t('nav.admin') %></a>
    <% } %>
    <% } else { %>
    <div class="pt-4 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= typeof t !== 'undefined' ? t('nav.account') : 'Account' %></p>
    </div>
    <a href="/auth/login" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <span class="mat-icon text-xl text-gray-500 dark:text-gray-400">login</span>
      <%= t('nav.login') %>
    </a>
    <% } %>
  </nav>

  <!-- Sidebar Footer -->
  <div class="p-4 border-t border-gray-200 dark:border-gray-700 shrink-0">
    <%- include('./_post-project-btn', {extraClass: 'w-full text-center'}) %>
    <a href="/" class="mt-2 flex items-center gap-3 px-4 py-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition text-sm">
      <span class="mat-icon text-xl">arrow_back</span>
      <%= typeof t !== 'undefined' ? t('nav.home') : 'Home' %>
    </a>
    <% if (typeof user !== 'undefined' && user) { %>
    <a href="/auth/logout" class="flex items-center gap-3 px-4 py-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-red-600 dark:hover:text-red-400 transition text-sm">
      <span class="mat-icon text-xl">logout</span>
      <%= t('nav.logout') %>
    </a>
    <% } %>
  </div>
</aside>
