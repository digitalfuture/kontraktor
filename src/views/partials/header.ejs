<!-- <%= t("header.skipToMain") %> (accessibility) -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-orange-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-700">
  <%= t("header.skipToMain") %>
</a>

<header class="bg-white dark:bg-gray-900 sticky top-0 z-50" role="banner">
  <!-- Thin gradient accent bar -->
  <div class="h-0.5 bg-gradient-to-r from-orange-500 via-orange-400 to-amber-500"></div>
  <div class="border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo + Mobile Hamburger (left) -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gray-700 dark:text-gray-300 hover:text-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-700" aria-label="<%= t("header.openMenu") %>" aria-expanded="false">
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <a href="/" class="text-2xl font-bold text-orange-700 hover:text-orange-700 transition" aria-label="<%= t("header.logoLabel") %>">
          Kontraktor
        </a>
      </div>
      
      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-6" aria-label="Main navigation">
        <a href="/services" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition"><%= t('nav.services') %></a>
        <a href="/projects" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition"><%= t('nav.browseProjects') %></a>
        <a href="/contractors" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition"><%= t('nav.contractors') %></a>
      </nav>
      
      <!-- Desktop Controls (Lang + Theme) -->
      <div class="hidden md:flex items-center space-x-3">
        <%- include('_controls', {
          locale: typeof locale !== 'undefined' ? locale : 'en',
          locales: typeof locales !== 'undefined' ? locales : ['id', 'en'],
          controlsIdPrefix: 'public',
          isAdmin: false,
          extraLangParams: ''
        }) %>
      </div>
      
      <!-- Auth / Account (desktop) -->
      <div class="hidden md:flex items-center space-x-4" role="navigation" aria-label="Account">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/account" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition font-medium">👤 <%= t('nav.account') %></a>
          <% if (user.is_contractor) { %>
            <a href="/contractors/dashboard" class="text-orange-700 dark:text-orange-400 hover:text-orange-700 transition font-medium" aria-label="<%= t('contractorDashboard.myBids') %>">📋 <%= t('contractorDashboard.myBids') %></a>
          <% } else if (user.role === 'client') { %>
            <a href="/contractors/register" class="text-orange-700 dark:text-orange-400 hover:text-orange-700 transition font-medium text-sm whitespace-nowrap"><%= t('account.registerContractor') %></a>
          <% } %>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="text-gray-500 dark:text-gray-300 hover:text-orange-600 transition text-sm">⚙️ <%= t('nav.admin') %></a>
          <% } %>
          <a href="/auth/logout" class="inline-flex items-center gap-1.5 text-gray-500 dark:text-gray-300 hover:text-red-600 transition text-sm"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg><%= t('nav.logout') %></a>
        <% } else { %>
          <a href="/auth/login" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 transition font-medium"><%= t('nav.login') %></a>
        <% } %>
        <%- include('./_post-project-btn') %>
      </div>
      
      <!-- Mobile Controls (lang, visible below md) -->
      <div class="md:hidden flex items-center space-x-1">
        <div class="flex items-center space-x-1" role="group" aria-label="Language switcher">
          <% typeof locales !== 'undefined' && locales.forEach(function(loc) { %>
            <a href="?lang=<%= loc %>" 
               class="px-2 py-1 rounded text-sm font-medium transition
                <%= locale === loc ? 'bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-200' : 'text-gray-500 dark:text-gray-300 hover:text-gray-700 dark:hover:text-gray-200' %>"
            >
              <%= loc.toUpperCase() %>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
  </div> <!-- /border-b -->
</header>

<!-- Mobile Sidebar (slides from left, md:hidden) -->
<aside id="mobile-sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 flex flex-col border-r border-gray-200 dark:border-gray-700 transform -translate-x-full md:hidden transition-transform duration-300 ease-in-out shadow-xl">
  <!-- Sidebar Header -->
  <div class="px-4 py-2 min-h-[3.25rem] border-b border-gray-200 dark:border-gray-700 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-3">
      <button onclick="var s=document.getElementById('mobile-sidebar');s.classList.add('-translate-x-full');s.classList.remove('translate-x-0');var b=document.getElementById('mobile-menu-btn');if(b)b.setAttribute('aria-expanded','false');var h=document.getElementById('hamburger-icon'),c=document.getElementById('close-icon');if(h&&c){h.classList.remove('hidden');c.classList.add('hidden');}" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 active:bg-gray-200 dark:active:bg-gray-700 text-gray-500 dark:text-gray-300 cursor-pointer transition-colors focus:outline-none" aria-label="Close sidebar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <a href="/" class="text-lg font-bold text-orange-700 leading-none">Kontraktor</a>
    </div>
  </div>

  <!-- Sidebar Nav -->
  <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
    <a href="/services" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      <%= t('nav.services') %>
    </a>
    <a href="/projects" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      <%= t('nav.browseProjects') %>
    </a>
    <a href="/contractors" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      <%= t('nav.contractors') %>
    </a>

    <!-- Theme Toggle (mobile) -->
    <div class="pt-4 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= typeof t !== 'undefined' ? t('nav.settings') || 'Settings' : 'Settings' %></p>
    </div>
    <button id="mobile-theme-toggle" class="flex items-center gap-3 w-full px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="mobile-theme-sun w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"/></svg>
      <svg class="mobile-theme-moon w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/></svg>
      <span><%= typeof t !== 'undefined' ? t('themeToggle') || 'Dark Mode' : 'Dark Mode' %></span>
    </button>

    <!-- Auth section -->
    <% if (typeof user !== 'undefined' && user) { %>
    <div class="pt-4 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= t('nav.account') %></p>
    </div>
    <a href="/account" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <%= t('nav.account') %>
    </a>
    <% if (user.is_contractor) { %>
    <a href="/contractors/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      📋 <%= t('contractorDashboard.myBids') %>
    </a>
    <% } else if (user.role === 'client') { %>
    <a href="/contractors/register" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-orange-700 dark:text-orange-400 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      <%= t('account.registerContractor') %>
    </a>
    <% } %>
    <% if (user.role === 'admin') { %>
    <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-500 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">⚙️ <%= t('nav.admin') %></a>
    <% } %>
    <% } else { %>
    <div class="pt-4 pb-1 px-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= typeof t !== 'undefined' ? t('nav.account') : 'Account' %></p>
    </div>
    <a href="/auth/login" class="flex items-center gap-3 px-4 py-3 rounded-lg transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
      <%= t('nav.login') %>
    </a>
    <% } %>
  </nav>

  <!-- Sidebar Footer -->
  <div class="p-4 border-t border-gray-200 dark:border-gray-700 shrink-0">
    <%- include('./_post-project-btn', {extraClass: 'w-full text-center'}) %>
    <a href="/" class="mt-2 flex items-center gap-3 px-4 py-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition text-sm">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m0 0h12"/></svg>
      <%= typeof t !== 'undefined' ? t('nav.home') : 'Home' %>
    </a>
    <% if (typeof user !== 'undefined' && user) { %>
    <a href="/auth/logout" class="flex items-center gap-3 px-4 py-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-red-600 dark:hover:text-red-400 transition text-sm">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      <%= t('nav.logout') %>
    </a>
    <% } %>
  </div>
</aside>
