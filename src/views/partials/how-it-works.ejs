<section id="how-it-works" class="py-16 sm:py-20 bg-gradient-to-b from-white via-orange-50/20 to-white dark:from-gray-900 dark:via-gray-950 dark:to-gray-900" aria-labelledby="how-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 max-w-2xl mx-auto">
      <h2 id="how-title" class="text-3xl sm:text-4xl font-black text-gray-900 dark:text-white tracking-tight"><%= t('howItWorks.title') %></h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300"><%= t('howItWorks.subtitle') %></p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% t('howItWorks.steps').forEach(function(step, i) { %>
        <div class="card-modern-glass p-8 text-center flex flex-col items-center">
          <div class="w-14 h-14 bg-gradient-to-tr from-orange-600 via-amber-500 to-orange-400 text-white rounded-2xl flex items-center justify-center text-2xl font-black shadow-lg shadow-orange-500/30 mb-6 transform transition-transform hover:scale-110">
            <%= i + 1 %>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3"><%= step.title %></h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed"><%= step.desc %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>
