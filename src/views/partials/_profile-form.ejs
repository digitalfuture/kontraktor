<% if (typeof profileSuccess !== 'undefined' && profileSuccess) { %>
<div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded-lg mb-6">
  <%= t('account.profileSaved') %>
</div>
<% } %>

<% if (typeof profileError !== 'undefined' && profileError) { %>
<div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded-lg mb-6">
  <% if (profileError === 'name_required') { %><%= t('account.nameRequired') %>
  <% } else if (profileError === 'email_invalid') { %><%= t('account.emailInvalid') %>
  <% } else if (profileError === 'email_taken') { %><%= t('account.emailTaken') %>
  <% } else if (profileError === 'phone_invalid') { %><%= t('account.phoneInvalid') %>
  <% } else { %><%= t('account.profileSaveError') %><% } %>
</div>
<% } %>

<form method="POST" action="/account/profile" class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 space-y-5" hx-post="/account/profile" hx-target="#profile-section" hx-swap="innerHTML">
  <%- include('../partials/csrf-field') %>
  <!-- Name -->
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"><%= t('account.nameLabel') %></label>
    <% if (typeof needsName !== 'undefined' && needsName) { %>
    <p class="text-sm text-orange-600 dark:text-orange-400 mb-2 font-medium"><%= t('account.nameRequired') %></p>
    <% } %>
    <input type="text" name="name" value="<%= user.name || '' %>" required
           class="w-full rounded-lg border <%= typeof needsName !== 'undefined' && needsName ? 'border-orange-400 dark:border-orange-500 ring-2 ring-orange-200 dark:ring-orange-800' : 'border-gray-300 dark:border-gray-600' %> bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
  </div>

  <!-- Email -->
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"><%= t('account.emailLabel') %></label>
    <input type="email" name="email" value="<%= user.email %>" required
           class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
  </div>

  <!-- Phone -->
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"><%= t('account.phoneLabel') %></label>
    <div class="flex">
      <span class="inline-flex items-center px-3 border border-r-0 border-gray-300 dark:border-gray-600 rounded-l-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-sm font-medium select-none">+62</span>
      <input type="tel" name="phone"
        value="<%= user.phone ? String(user.phone).replace(/^\+62/, '') : '' %>"
        placeholder="81234567890"
        maxlength="14"
        class="flex-1 px-4 py-2.5 border border-gray-300 dark:border-gray-600 rounded-r-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white outline-none transition">
    </div>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('post.phoneHint') || 'Masukkan nomor setelah +62' %></p>
  </div>

  <!-- Telegram ID -->
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"><%= t('account.telegramLabel') %></label>
    <input type="text" name="telegram_id" value="<%= user.telegram_id || '' %>" placeholder="@username"
           class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('auth.telegramOptional') %></p>
  </div>

  <!-- Submit -->
  <div class="flex justify-end pt-2">
    <button type="submit" class="bg-gradient-to-r from-orange-600 to-amber-500 text-white px-6 py-2.5 rounded-lg hover:from-orange-700 hover:to-amber-600 transition font-medium">
      <%= t('account.saveProfile') %>
    </button>
  </div>
</form>
