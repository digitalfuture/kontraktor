<%
/**
 * Общий компонент пагинации.
 * Параметры:
 *   pagination { page, totalPages, limit, totalItems, total, baseUrl, params? }
 *   htmx (bool) — HTMX-режим (админка): ?page=N, hx-get/hx-push-url
 *   target (строка) — hx-target для HTMX-режима (по умолч. '#paginated-list')
 */
var p = pagination;
var _pg_htmx = typeof htmx !== 'undefined' && htmx;
var _pg_target = typeof target !== 'undefined' ? target : '#paginated-list';
function _pg_buildUrl(pageNum) {
  if (_pg_htmx) return '?page=' + pageNum;
  var qs = 'page=' + pageNum + '&limit=' + p.limit;
  var params = p.params || {};
  for (var key in params) { if (params[key]) qs += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(params[key]); }
  return p.baseUrl + '?' + qs;
}
function _pg_hxAttr(pageNum) {
  if (!_pg_htmx) return '';
  return ' hx-get="' + _pg_buildUrl(pageNum) + '" hx-target="' + _pg_target + '" hx-swap="outerHTML" hx-push-url="true" hx-select="' + _pg_target + '"';
}
%>
<% if (p && p.totalPages > 1) { %>
<% if (_pg_htmx) { %>
<div class="flex flex-col sm:flex-row items-center justify-between px-4 sm:px-6 py-4 border-t border-gray-200 dark:border-gray-700 gap-3">
  <p class="text-sm text-gray-500 dark:text-gray-300">
    <%= typeof t !== 'undefined' ? t('admin.adminPaginationShowing').replace('{from}', (p.page - 1) * 10 + 1).replace('{to}', Math.min(p.page * 10, p.total)).replace('{total}', p.total) : 'Showing ' + ((p.page - 1) * 10 + 1) + '-' + Math.min(p.page * 10, p.total) + ' of ' + p.total + ' items' %>
  </p>
  <nav class="flex items-center gap-1">
    <a href="<%= _pg_buildUrl(p.page - 1) %>"<%= _pg_hxAttr(p.page - 1) %>
       class="px-3 py-1.5 text-sm text-gray-500 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 rounded-lg cursor-pointer transition <%= p.page <= 1 ? 'invisible pointer-events-none' : '' %>"
       <%= p.page <= 1 ? 'tabindex="-1" aria-hidden="true"' : '' %>>
      <%= typeof t !== 'undefined' ? t('admin.adminPaginationPrevious') : 'Previous' %>
    </a>
    <% for (var i = 1; i <= p.totalPages; i++) { %>
      <% if (i === p.page) { %>
        <span class="px-3 py-1.5 text-sm bg-orange-700 text-white rounded-lg font-medium"><%= i %></span>
      <% } else { %>
        <a href="<%= _pg_buildUrl(i) %>"<%= _pg_hxAttr(i) %>
           class="px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 cursor-pointer transition">
          <%= i %>
        </a>
      <% } %>
    <% } %>
    <a href="<%= _pg_buildUrl(p.page + 1) %>"<%= _pg_hxAttr(p.page + 1) %>
       class="px-3 py-1.5 text-sm text-gray-500 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 rounded-lg cursor-pointer transition <%= p.page >= p.totalPages ? 'invisible pointer-events-none' : '' %>"
       <%= p.page >= p.totalPages ? 'tabindex="-1" aria-hidden="true"' : '' %>>
      <%= typeof t !== 'undefined' ? t('admin.adminPaginationNext') : 'Next' %>
    </a>
  </nav>
</div>
<% } else { %>
<nav class="flex items-center justify-center gap-1 mt-8" aria-label="Pagination">
  <% if (p.page > 1) { %>
  <a href="<%= _pg_buildUrl(p.page - 1) %>" class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition" aria-label="Previous page">
    ← <%= t('pagination.previous') %>
  </a>
  <% } %>

  <% for (var i = 1; i <= p.totalPages; i++) { %>
    <% if (i === 1 || i === p.totalPages || Math.abs(i - p.page) <= 1) { %>
    <a href="<%= _pg_buildUrl(i) %>"
       class="px-3 py-2 rounded-lg text-sm font-medium transition <%= i === p.page ? 'bg-orange-700 text-white' : 'border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800' %>"
       aria-label="Page <%= i %>" <%= i === p.page ? 'aria-current="page"' : '' %>>
      <%= i %>
    </a>
    <% } else if (i === p.page - 2 || i === p.page + 2) { %>
    <span class="px-2 text-gray-400">…</span>
    <% } %>
  <% } %>

  <% if (p.page < p.totalPages) { %>
  <a href="<%= _pg_buildUrl(p.page + 1) %>" class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition" aria-label="Next page">
    <%= t('pagination.next') %> →
  </a>
  <% } %>
</nav>
<p class="text-center text-sm text-gray-500 dark:text-gray-300 mt-2">
  <% var pageInfoStr = t('pagination.pageInfo').replace('{page}', p.page).replace('{totalPages}', p.totalPages).replace('{totalItems}', p.totalItems); %><%= pageInfoStr %>
</p>
<% } %>
<% } %>
