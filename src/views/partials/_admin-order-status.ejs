<!-- Admin Order Status - HTMX: select change auto-submits, response replaces wrapper -->
<%#
  Params:
    order  — order object with .id, .status
    prefix — unique disambiguator per include-site (e.g. 'row', 'detail')
%>
<div id="order-status-wide-<%= prefix %>-<%= order.id %>">
  <form>
    <%- include('../partials/csrf-field') %>
    <input type="hidden" name="prefix" value="<%= prefix %>">
    <select name="status" hx-post="/api/admin/projects/<%= order.id %>/status" hx-trigger="change" hx-target="#order-status-wide-<%= prefix %>-<%= order.id %>" hx-swap="outerHTML" hx-include="closest form" class="hidden min-[1600px]:inline-block text-xs px-1.5 py-1 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 cursor-pointer whitespace-nowrap">
      <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>><%= t('admin.pending') %></option>
      <option value="in_progress" <%= order.status === 'in_progress' ? 'selected' : '' %>><%= t('admin.inProgress') %></option>
      <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>><%= t('admin.done') %></option>
      <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>><%= t('admin.cancelLabel') %></option>
    </select>
  </form>
</div>
<div id="order-status-compact-<%= prefix %>-<%= order.id %>">
  <form>
    <%- include('../partials/csrf-field') %>
    <input type="hidden" name="prefix" value="<%= prefix %>">
    <select name="status" hx-post="/api/admin/projects/<%= order.id %>/status" hx-trigger="change" hx-target="#order-status-compact-<%= prefix %>-<%= order.id %>" hx-swap="outerHTML" hx-include="closest form" class="min-[1600px]:hidden px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-orange-500 outline-none">
      <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>><%= t('admin.pending') %></option>
      <option value="in_progress" <%= order.status === 'in_progress' ? 'selected' : '' %>><%= t('admin.inProgress') %></option>
      <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>><%= t('admin.done') %></option>
      <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>><%= t('admin.cancelLabel') %></option>
    </select>
  </form>
</div>
