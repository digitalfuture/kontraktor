<!-- Shared language & theme controls -->
<div class="flex items-center space-x-3">
  <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <%- include('../admin/_edit-mode') %>
  <% } %>

  <!-- Language switcher -->
  <div class="flex items-center space-x-1" role="group" aria-label="Language switcher">
    <% typeof locales !== 'undefined' && locales.forEach(function(loc) { %>
      <a href="?lang=<%= loc %><%= typeof extraLangParams !== 'undefined' ? extraLangParams : '' %>" 
         class="px-2 py-1 rounded text-sm font-medium transition cursor-pointer
           <%= locale === loc ? 'bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-200' : 'text-gray-500 dark:text-gray-300 hover:text-gray-700 dark:hover:text-gray-200' %>"
      >
        <%= loc.toUpperCase() %>
      </a>
    <% }); %>
  </div>
  
  <!-- Theme toggle -->
  <button type="button" id="<%= typeof controlsIdPrefix !== 'undefined' ? controlsIdPrefix : 'page' %>-theme-toggle" class="p-2 rounded-lg text-gray-500 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer" aria-label="Toggle dark mode">
    <span id="<%= typeof controlsIdPrefix !== 'undefined' ? controlsIdPrefix : 'page' %>-theme-toggle-sun" class="mat-icon text-inherit hidden" aria-hidden="true">light_mode</span>
    <span id="<%= typeof controlsIdPrefix !== 'undefined' ? controlsIdPrefix : 'page' %>-theme-toggle-moon" class="mat-icon text-inherit hidden" aria-hidden="true">dark_mode</span>
  </button>
</div>

<script>
(function() {
  var prefix = '<%= typeof controlsIdPrefix !== 'undefined' ? controlsIdPrefix : 'page' %>';
  var html = document.documentElement;
  var stored = null;
  try { stored = localStorage.getItem('theme'); } catch(e) {}

  function applyTheme(theme) {
    if (theme === 'dark') html.classList.add('dark');
    else html.classList.remove('dark');
    updateIcons();
  }

  function updateIcons() {
    var isDark = html.classList.contains('dark');
    var sun = document.getElementById(prefix + '-theme-toggle-sun');
    var moon = document.getElementById(prefix + '-theme-toggle-moon');
    if (sun) sun.classList.toggle('hidden', !isDark);
    if (moon) moon.classList.toggle('hidden', isDark);
  }

  if (stored === 'dark' || stored === 'light') applyTheme(stored);
  else if (window.matchMedia('(prefers-color-scheme: dark)').matches) applyTheme('dark');
  else applyTheme('light');

  var btn = document.getElementById(prefix + '-theme-toggle');
  if (btn) btn.addEventListener('click', function() {
    var isDark = html.classList.contains('dark');
    var newTheme = isDark ? 'light' : 'dark';
    try { localStorage.setItem('theme', newTheme); } catch(e) {}
    applyTheme(newTheme);
  });
})();
</script>
