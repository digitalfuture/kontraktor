<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
  <%- include('../partials/_head') %>
<body class="bg-gray-100 dark:bg-gray-950 min-h-screen flex items-center justify-center">
  <%- include('../partials/_anti-flash') %>
  
  <div class="max-w-md w-full mx-4">
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-8 text-center">
      <% if (typeof emailSent !== 'undefined' && emailSent || typeof telegramSent !== 'undefined' && telegramSent) { %>
      <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="mat-icon text-green-500 text-3xl">mail</span>
      </div>
      <h1 class="text-xl font-semibold text-gray-900 dark:text-white mb-2"><%= t('auth.sentTitle') %></h1>
      <p class="text-gray-500 dark:text-gray-300 mb-4"><%= t('auth.sentSubtitle') %> <strong><%= email %></strong></p>
      <p class="text-sm text-gray-400 dark:text-gray-500 mb-6"><%= t('auth.linkExpires') %></p>

      <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 mb-6 text-left space-y-2">
        <% if (emailSent) { %>
        <div class="text-sm text-gray-700 dark:text-gray-300">
          <p class="inline-flex items-center gap-2 whitespace-nowrap"><span class="mat-icon text-base">mail</span> <%= t('auth.sentToEmail') %></p>
          <p class="font-medium text-gray-900 dark:text-white break-all mt-1.5 pl-7"><%= email %></p>
        </div>
        <% } %>
        <% if (telegramSent) { %>
        <p class="text-sm text-gray-700 dark:text-gray-300 inline-flex items-center gap-2"><span class="mat-icon text-base">send</span> <%= t('auth.sentToTelegram') %></p>
        <% } %>
      </div>
      <% } else { %>
      <div class="w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="mat-icon text-red-500 text-3xl">error</span>
      </div>
      <h1 class="text-xl font-semibold text-gray-900 dark:text-white mb-4"><%= t('auth.sendFailed') %></h1>
      <p class="text-sm text-red-600 dark:text-red-400 mb-6"><%= t('auth.sendFailedHint') %></p>
      <% } %><a href="/auth/login" class="text-orange-700 hover:underline text-sm">← <%= t('auth.backToLogin') %></a>
    </div>
  </div>
</body>
</html>
