<!DOCTYPE html>
<html lang="<%= locale %>">
<%- include('partials/_head') %>
<body class="bg-gray-200 dark:bg-gray-950 text-gray-900 dark:text-gray-100">
  <%- include('partials/_anti-flash') %>
  <%- include('partials/header') %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-300 hover:text-orange-600 transition mb-4">
          ← <%= t('nav.home') %>
        </a>
    <!-- Success/Error messages -->
    <% if (success === 'avatar') { %>
    <div class="mb-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-green-700 dark:text-green-300">
      ✅ <%= t('contractorDashboard.avatarUpdated') %>
    </div>
    <% } else if (success === 'portfolio') { %>
    <div class="mb-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-green-700 dark:text-green-300">
      ✅ <%= t('contractorDashboard.photosUploaded') %>
    </div>
    <% } else if (success === 'photo_deleted') { %>
    <div class="mb-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-green-700 dark:text-green-300">
      ✅ <%= t('contractorDashboard.photoDeleted') %>
    </div>
    <% } else if (error) { %>
    <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-red-700 dark:text-red-300">
      ❌ <%= t('contractorDashboard.uploadFailed') %>
    </div>
    <% } %>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 gap-4">
      <div class="flex items-center gap-4">
        <!-- Avatar + upload form -->
        <form action="/api/contractors/dashboard/avatar?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="flex-shrink-0">
          <div class="relative group">
            <% if (contractor.avatar_url) { %>
            <img src="<%= contractor.avatar_url %>" alt="<%= t("contractorDashboard.avatar") %>" class="w-16 h-16 rounded-full object-cover border-2 border-orange-200 dark:border-orange-800" loading="lazy" width="64" height="64">
            <% } else { %>
            <div class="w-16 h-16 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-2xl font-bold text-orange-700 dark:text-orange-200 border-2 border-orange-200 dark:border-orange-800">
              <%= (contractor.name || '?')[0].toUpperCase() %>
            </div>
            <% } %>
            <label class="absolute inset-0 flex items-center justify-center bg-black/50 rounded-full opacity-0 group-hover:opacity-100 transition cursor-pointer" title="Change avatar">
              <span class="mat-icon text-2xl text-white">camera_alt</span>
              <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="this.form.submit()">
            </label>
          </div>
        </form>
        <div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= contractor.name %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= t('contractorDashboard.title') %></p>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
        <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.total %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('contractorDashboard.totalBids') %></p>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
        <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400"><%= stats.pending %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('contractorDashboard.pending') %></p>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
        <p class="text-2xl font-bold text-green-600 dark:text-green-400"><%= stats.accepted %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('contractorDashboard.accepted') %></p>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
        <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= stats.rejected %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('contractorDashboard.declined') %></p>
      </div>
    </div>

    <!-- Bids list -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-8">
      <div class="p-6 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white"><%= t('contractorDashboard.myBids') %></h2>
      </div>
      <% if (bids && bids.length > 0) { %>
      <div class="divide-y divide-gray-100 dark:divide-gray-700">
        <% bids.forEach(function(bid) { %>
        <div class="p-6 flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-gray-900 dark:text-white truncate"><%= bid.project_title %></h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
              <span class="inline-flex items-center gap-1"><span class="mat-icon text-xs">category</span> <%= bid.category_display || bid.category %></span>
              <% if (bid.bid_amount) { %>
              <span class="ml-3 inline-flex items-center gap-1"><span class="mat-icon text-xs">attach_money</span> Rp <%= Number(bid.bid_amount).toLocaleString('id-ID') %></span>
              <% } %>
            </p>
          </div>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
            <%= bid.status === 'accepted' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' :
               bid.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' :
               'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
            <%= bid.status === 'accepted' ? t('contractorDashboard.accepted') :
               bid.status === 'rejected' ? t('contractorDashboard.declined') :
               t('contractorDashboard.pending') %>
          </span>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="p-12 text-center">
        <p class="text-gray-500 dark:text-gray-300 text-lg mb-2"><%= t('contractorDashboard.noBidsYet') %></p>
        <a href="/projects" class="text-orange-700 hover:text-orange-800 font-medium"><%= t('contractorDashboard.browseProjects') %></a>
      </div>
      <% } %>
    </div>

    <!-- Portfolio -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-8">
      <div class="p-6 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white"><%= t('contractorDashboard.portfolio') %></h2>
      </div>
      <form action="/api/contractors/dashboard/portfolio?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="p-6">
        <div class="flex items-center gap-3 mb-4">
          <label class="inline-flex items-center gap-2 px-4 py-2 bg-orange-700 text-white rounded-lg cursor-pointer hover:bg-orange-800 transition text-sm font-medium">
            <span class="mat-icon text-base">add_photo_alternate</span>
            <%= t('contractorDashboard.addPhotos') %>
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple class="hidden" id="portfolio-upload" onchange="this.form.submit()">
          </label>
        </div>
      </form>

      <% if (photos && photos.length > 0) { %>
      <div class="p-6 pt-0">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <% photos.forEach(function(photo) { %>
          <div class="relative">
            <img src="/uploads/<%= photo.filename %>" alt="<%= photo.caption || '' %>" class="w-full h-40 object-cover rounded-lg border border-gray-200 dark:border-gray-700" loading="lazy">
            <div class="absolute top-2 right-2">
              <form action="/api/contractors/dashboard/photo/<%= photo.id %>/delete?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" onsubmit="return confirm('<%= t('contractorDashboard.deletePhotoConfirm') %>')">
                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-xs px-2 py-1 rounded cursor-pointer"><%= t('contractorDashboard.deletePhoto') %></button>
              </form>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } else { %>
      <div class="p-12 text-center">
        <p class="text-gray-500 dark:text-gray-300 text-lg mb-2"><%= t('contractorDashboard.noPortfolio') %></p>
        <p class="text-gray-400 dark:text-gray-500 text-sm"><%= t('contractorDashboard.noPortfolioSub') %></p>
      </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>