<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
  <%- include('partials/_head') %>
<body class="bg-gray-200 dark:bg-gray-950 text-gray-900 dark:text-gray-100">
  <%- include('partials/_anti-flash') %>
  <%- include('partials/header') %>

  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <nav class="text-sm text-gray-500 dark:text-gray-300 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-orange-600 transition"><%= t('nav.home') %></a>
      <span class="mx-2">/</span>
      <% if (typeof currentLocation !== 'undefined' && currentLocation) { %>
        <a href="/contractors" class="hover:text-orange-600 transition"><%= t('nav.contractors') %></a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 dark:text-gray-100"><%= locale === 'id' ? currentLocation.nameId : currentLocation.nameEn %></span>
      <% } else { %>
        <span class="text-gray-900 dark:text-gray-100"><%= t('nav.contractors') %></span>
      <% } %>
    </nav>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold">
          <% if (typeof currentLocation !== 'undefined' && currentLocation) { %>
            <%= t('contractors.titleCity', { city: locale === 'id' ? currentLocation.nameId : currentLocation.nameEn }) %>
          <% } else { %>
            <%= t('contractors.title') %>
          <% } %>
        </h1>
        <p class="text-gray-600 dark:text-gray-300 mt-1"><%= contractors.length %> <%= contractors.length === 1 ? t('contractors.one') : t('contractors.subtitle') %></p>
      </div>
      <% if (typeof user === 'undefined' || !user || !user.is_contractor) { %>
      <a href="/contractors/register" class="bg-orange-700 text-white px-5 py-2 rounded-lg hover:bg-orange-800 transition font-medium text-sm">
        <%= t('contractors.join') %>
      </a>
      <% } %>
    </div>

    <!-- Search & Filters -->
    <form method="GET" action="<%= typeof currentLocation !== 'undefined' && currentLocation ? '/contractors/' + currentLocation.slug : '/contractors' %>" class="flex flex-col sm:flex-row gap-3 mb-8">
      <div class="flex-1">
        <input type="text" name="search" value="<%= search %>" placeholder="<%= t('contractors.searchPlaceholder') %>"
          class="w-full h-11 px-4 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-orange-500 outline-none">
      </div>
      <div class="sm:w-48">
        <select name="specialty" onchange="this.form.submit()"
          class="w-full h-11 px-4 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-orange-500 outline-none">
          <option value=""><%= t('contractors.allSpecialties') %></option>
          <% if (typeof specialties !== 'undefined') { specialties.forEach(function(s) { %>
          <option value="<%= s.slug %>" <%= specialty === s.slug ? 'selected' : '' %>><%= s.name %></option>
          <% }); } %>
        </select>
      </div>
      <%- include('partials/_search-btn', { size: 'md' }) %>
      <% if (search || specialty) { %>
        <a href="<%= typeof currentLocation !== 'undefined' && currentLocation ? '/contractors/' + currentLocation.slug : '/contractors' %>" class="text-sm text-gray-500 dark:text-gray-300 hover:text-orange-600 px-3 py-2.5"><%= t('contractors.clear') %></a>
      <% } %>
      </form>

      <!-- Sort -->
      <div class="flex items-center gap-2 mb-6 text-sm">
        <span class="text-gray-500 dark:text-gray-300"><%= t('contractors.sortBy') %>:</span>
        <a href="?sort=projects<%= search ? '&search=' + search : '' %><%= specialty ? '&specialty=' + specialty : '' %>"
           class="px-3 py-1.5 rounded-lg transition <%= sort === 'projects' || !sort ? 'bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-200 font-medium' : 'text-gray-600 dark:text-gray-300 hover:text-orange-600' %>">
          <%= t('contractors.sortProjects') %>
        </a>
        <a href="?sort=name<%= search ? '&search=' + search : '' %><%= specialty ? '&specialty=' + specialty : '' %>"
           class="px-3 py-1.5 rounded-lg transition <%= sort === 'name' ? 'bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-200 font-medium' : 'text-gray-600 dark:text-gray-300 hover:text-orange-600' %>">
          <%= t('contractors.sortName') %>
        </a>
      </div>

    <% if (contractors.length === 0) { %>
    <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
      <% if (search || specialty) { %>
      <p class="text-gray-500 dark:text-gray-300 text-lg mb-4"><%= t('contractors.noContractors') %></p>
      <a href="/contractors" class="text-orange-700 hover:underline"><%= t('projects.clearFilters') %></a>
      <% } else { %>
      <p class="text-gray-700 dark:text-gray-300 text-lg mb-4 font-medium max-w-2xl mx-auto"><%= t('contractors.emptyOffer') %></p>
      <a href="/contractors/register" class="inline-block bg-orange-700 text-white px-6 py-2 rounded-lg hover:bg-orange-800 transition font-medium">
        <%= t('contractors.join') %>
      </a>
      <% } %>
    </div>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% contractors.forEach(function(c) { %>
      <a href="/contractors/<%= c.id %>" class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg transition block group">
        <div class="flex items-center gap-4 mb-4">
          <% if (c.avatar_url) { %>
          <img src="<%= c.avatar_url %>" alt="<%= c.name %>" class="w-14 h-14 rounded-full object-cover border-2 border-orange-200 dark:border-orange-800" loading="lazy" width="56" height="56">
          <% } else { %>
          <div class="w-14 h-14 bg-orange-100 dark:bg-orange-900/30 rounded-full flex items-center justify-center text-xl font-bold text-orange-700 dark:text-orange-200 group-hover:bg-orange-200 dark:group-hover:bg-orange-900/50 transition">
            <%= c.name.charAt(0).toUpperCase() %>
          </div>
          <% } %>
          <div>
            <h3 class="font-semibold text-lg group-hover:text-orange-600 transition"><%= c.name %></h3>
            <p class="text-sm text-gray-500 dark:text-gray-300"><%
              let _slugs = [];
              if (c.active_services) {
                _slugs = c.active_services.split(',').map(s => s.trim()).filter(s => s);
              } else if (c.specialty) {
                _slugs = [c.specialty];
              }
              let _names = _slugs.map(slug => {
                let _n = t('categories.' + slug);
                return _n && !_n.startsWith('categories.') ? _n : slug;
              });
              if (_names.length === 0) {
                %><%= t('contractors.general') %><%
              } else if (_names.length === 1) {
                %><%= _names[0] %><%
              } else if (_names.length === 2) {
                %><%= _names[0] %> <%= t('common.and') %> <%= _names[1] %><%
              } else {
                %><%= _names.slice(0, -1).join(', ') %>, <%= t('common.and') %> <%= _names[_names.length - 1] %><%
              }
            %></p>
            <% if (c.is_verified && c.rating >= 4) { %>
            <%- include('partials/_verified-badge', {label: t('contractors.verified')}) %>
            <% } %>
          </div>
        </div>
        <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-300">
          <% var avg = parseFloat(c.avg_rating || 0); %>
          <% if (avg > 0) { %>
          <span class="inline-flex items-center gap-1"><span class="mat-icon text-sm">star</span> <%= avg.toFixed(1) %></span>
          <% } else { %>
          <span class="text-gray-400"><%= t('contractors.noReviews') %></span>
          <% } %>
          <span><%= c.completed_projects || 0 %> <%= t('contractorProfile.projectsCompleted') %></span>
        </div>
        <% if (c.bio) { %>
        <p class="text-sm text-gray-500 dark:text-gray-300 mt-3 line-clamp-2"><%= c.bio %></p>
        <% } %>
      </a>
      <% }); %>
    </div>
    <% } %>

    <!-- Pagination -->
    <%- include('partials/pagination') %>

    <!-- Cities & Regions Interlinking for Local SEO -->
    <% if (typeof locations !== 'undefined' && locations && locations.length) { %>
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800" aria-labelledby="cities-heading">
      <h2 id="cities-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-orange-600 dark:text-orange-400" aria-hidden="true">location_on</span>
        <%= typeof currentLocation !== 'undefined' && currentLocation ? t('contractors.contractorsByCity') : t('contractors.popularCities') %>
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <% locations.forEach(function(loc) { %>
        <a href="/contractors/<%= loc.slug %>" class="flex items-center justify-between p-3.5 rounded-card bg-surface dark:bg-surface-dark border <%= (typeof currentLocation !== 'undefined' && currentLocation && currentLocation.slug === loc.slug) ? 'border-orange-500 font-semibold text-orange-700 dark:text-orange-400 ring-1 ring-orange-500' : 'border-gray-200 dark:border-gray-700 hover:border-orange-500 dark:hover:border-orange-500 hover:shadow-card-hover text-gray-700 dark:text-gray-200' %> transition">
          <span class="text-sm"><%= locale === 'id' ? loc.nameId : loc.nameEn %></span>
          <span class="material-symbols-outlined text-xs text-gray-400" aria-hidden="true">arrow_forward</span>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script>
    // Remember list state so "Back to Contractors" returns to the same page/filters
    sessionStorage.setItem('kontraktorBack.contractors', location.pathname + location.search);
  </script>
</body>
</html>